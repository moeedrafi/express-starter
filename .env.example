# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?options

# Server Configuration
PORT=8000
APP_STAGE=dev
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_is_long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_super_refresh_secret_jwt_key_here_is_long
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_TOKEN_SECRET=your_super_refresh_secret_jwt_key_here_is_long
RESET_PASSWORD_TOKEN_EXPIRES_IN=900000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# MAIL
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=